PORT=8080
JANSEVA_ADMIN_TOKEN=change-me-long-random      # super admin token
JANSEVA_DB=/data/jansevaai.sqlite3
JANSEVA_UPLOADS=/data/uploads
JANSEVA_REQUIRE_OTP=1                          # disable the dev /api/register login
JANSEVA_DEV_OTP=0                              # 1 returns the OTP in the API response (dev only; no SMS provider wired)
# Live Swachhata (only with ULB-issued credentials; otherwise leave unset to stay in sandbox)
SWACHHATA_LIVE=0
SWACHHATA_VENDOR_NAME=
SWACHHATA_ACCESS_KEY=
GEMINI_API_KEY=   # optional, server-side only, enables photo classification
GEMINI_MODEL=gemini-2.5-flash
